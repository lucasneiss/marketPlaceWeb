<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Histórico de compras</p><h1 class="h2 mb-0">Meus pedidos</h1></div><a href="/catalog" class="btn btn-outline-secondary">Comprar novamente</a></div>
<% if (!orders.length) { %><div class="alert alert-light border">Você ainda não realizou compras.</div><% } %>
<div class="row g-3"><% orders.forEach(function(order) { %><div class="col-12"><article class="card shadow-sm"><div class="card-body d-flex flex-column flex-md-row justify-content-between gap-3"><div><span class="badge text-bg-light mb-2"><%= order.statusLabel %></span><h2 class="h5 mb-1">Pedido <%= order.number %></h2><p class="text-muted mb-0"><%= new Date(order.createdAt).toLocaleString('pt-BR') %> · <%= order.items.length %> item(ns)</p></div><div class="text-md-end"><strong class="d-block fs-5"><%= order.formattedTotal %></strong><a href="/orders/<%= order.id %>" class="btn btn-outline-primary btn-sm mt-2">Ver detalhes</a></div></div></article></div><% }) %></div>
