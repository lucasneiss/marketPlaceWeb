<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Controle de acesso</p><h1 class="h2 mb-0">Usuários</h1></div><a href="/admin" class="btn btn-outline-secondary">Painel</a></div><div class="table-responsive"><table class="table bg-white align-middle"><thead><tr><th>Nome</th><th>E-mail</th><th>Perfis</th><th>Situação</th><th>Último login</th><th></th></tr></thead><tbody><% users.forEach(function(user){ %><tr><td><strong><%= user.name %></strong></td><td><%= user.email %></td><td><%= user.roles.map(r=>r.name).join(', ') %></td><td><span class="badge <%= user.status==='ACTIVE'?'text-bg-success':'text-bg-danger' %>"><%= user.status %></span></td><td><%= user.lastLoginAt ? new Date(user.lastLoginAt).toLocaleString('pt-BR') : 'Nunca' %></td><td><% if(user.id!==currentUser.id){ %><form action="/admin/users/<%= user.id %>/toggle" method="POST"><button class="btn btn-sm <%= user.status==='ACTIVE'?'btn-outline-danger':'btn-outline-success' %>"><%= user.status==='ACTIVE'?'Bloquear':'Desbloquear' %></button></form><% } %></td></tr><% }) %></tbody></table></div>
