<section class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><div class="d-flex gap-3 align-items-center"><div class="display-5"><i class="bi bi-shop"></i></div><div><p class="text-uppercase text-muted small mb-1">Perfil público do vendedor</p><h1 class="h2 mb-1"><%= seller.storeName %></h1><p class="mb-0"><%= seller.description || 'Vendedor do Marketplace.' %></p></div></div></div></section>
<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="section-eyebrow mb-1">Catálogo da loja</p><h2 class="section-title mb-0">Produtos de <%= seller.storeName %></h2></div><span class="badge text-bg-light"><%= products.length %> produtos</span></div>
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-4"><% products.forEach(function(product) { %><%- include('../partials/catalog-product-card', { product }) %><% }) %></div>
<% if (!products.length) { %><div class="alert alert-light border">Esta loja ainda não possui produtos ativos.</div><% } %>
