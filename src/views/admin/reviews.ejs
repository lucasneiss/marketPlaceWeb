<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Conteúdo dos clientes</p><h1 class="h2 mb-0">Moderar avaliações</h1></div><a href="/admin" class="btn btn-outline-secondary">Painel</a></div><div class="row g-3"><% reviews.forEach(function(review){ %><div class="col-md-6"><article class="card h-100 shadow-sm" data-admin-review="<%= review.id %>"><div class="card-body"><div class="d-flex justify-content-between"><strong><%= review.product.name %></strong><span class="badge text-bg-light" data-review-status><%= review.status %></span></div><div class="text-warning my-2"><%= review.rating %>/5</div><p><%= review.comment %></p><small class="text-muted">Por <%= review.client.name %> (<%= review.client.email %>)</small><div class="d-flex gap-2 mt-3"><button class="btn btn-sm btn-outline-success" data-review-action="APPROVED">Aprovar</button><button class="btn btn-sm btn-outline-danger" data-review-action="HIDDEN">Ocultar</button><button class="btn btn-sm btn-outline-secondary" data-review-action="PENDING">Pendente</button></div><div class="small mt-2" data-review-message></div></div></article></div><% }) %></div><% if(!reviews.length){ %><div class="alert alert-light border">Nenhuma avaliação cadastrada.</div><% } %>
