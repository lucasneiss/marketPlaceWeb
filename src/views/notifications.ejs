<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-muted mb-1">Central de avisos</p><h1 class="h2 mb-0">Notificações</h1></div><button class="btn btn-outline-primary" data-read-all <%= notifications.some(n => !n.read) ? '' : 'disabled' %>>Marcar todas como lidas</button></div>
<div data-notification-list><% if (!notifications.length) { %><div class="alert alert-light border">Você ainda não tem notificações.</div><% } %><% notifications.forEach(function(n) { %><article class="card mb-2 <%= n.read ? '' : 'border-primary' %>" data-notification-id="<%= n.id %>"><div class="card-body d-flex justify-content-between align-items-center gap-3"><div><div><%= n.message %></div><small class="text-muted"><%= new Date(n.createdAt).toLocaleString('pt-BR') %></small></div><div class="d-flex gap-2"><% if (n.url) { %><a class="btn btn-sm btn-outline-secondary" href="<%= n.url %>">Abrir</a><% } %><% if (!n.read) { %><button class="btn btn-sm btn-outline-primary" data-read-notification>Marcar como lida</button><% } %></div></div></article><% }) %></div>
