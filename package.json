{
  "name": "trabalho-daw-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace multiusuário acadêmico com Node.js, EJS, Sequelize, SQLite, jQuery e Socket.IO",
  "main": "app.js",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "sequelize": "^6.37.7",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "start": "node app.js",
    "db:init": "node src/database/init.js",
    "db:reset": "node src/database/init.js --force",
    "db:check": "node src/database/check.js",
    "dev": "node --watch app.js",
    "check": "node scripts/static-check.js"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
