<div class="col" data-catalog-product>
    <article class="catalog-product-card h-100">
        <a
            class="catalog-product-image
                <%= product.imageClass %>
                <%= product.positionClass %>"
            href="/products/<%= encodeURIComponent(product.slug) %>"
            aria-label="Ver detalhes de <%= product.name %>"
        >
            <% if (product.discountLabel) { %>
                <span class="discount-badge">
                    <%= product.discountLabel %>
                </span>
            <% } %>

            <span
                class="catalog-stock-badge
                <%= product.isAvailable
                    ? 'is-available'
                    : 'is-unavailable' %>"
            >
                <%= product.isAvailable
                    ? 'Em estoque'
                    : 'Esgotado' %>
            </span>
        </a>

        <div class="catalog-product-body">
            <a href="/catalog?category=<%= product.category.slug %>">
                <%= product.category.name %>
            </a>

            <h2 class="catalog-product-name">
                <a href="/products/<%= product.slug %>">
                    <%= product.name %>
                </a>
            </h2>

            <p>
                Vendido por
                <strong><%= product.seller.storeName %></strong>
            </p>

            <strong class="catalog-price">
                <%= product.formattedPrice %>
            </strong>
        </div>
    </article>
</div>