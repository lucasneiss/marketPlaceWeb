<div class="auth-box">
    <h2>Acessar sua Conta</h2>
    <p>Entre para gerenciar seus produtos ou realizar compras.</p>

    <form action="/login" method="POST">
        <div class="form-group">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" placeholder="exemplo@email.com" required>
        </div>

        <div class="form-group">
            <label for="password">Senha</label>
            <input type="password" id="password" name="password" placeholder="Sua senha secreta" required>
        </div>

        <button type="submit" class="btn-primary">Entrar</button>
    </form>

    <p class="auth-footer">
        Ainda não tem uma conta? <a href="/register">Cadastre-se aqui</a>.
    </p>
</div>