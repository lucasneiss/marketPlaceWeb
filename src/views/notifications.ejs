<div class="col-md-8 mx-auto">
    <h2>Notificações</h2>

    <% if (notifications.length === 0) { %>
        <p class="text-muted">Você ainda não tem notificações.</p>
    <% } %>

    <% notifications.forEach(function(n) { %>
        <div class="card mb-2 <%= n.read ? '' : 'border-primary' %>">
            <div class="card-body d-flex justify-content-between align-items-center">
                <span><%= n.message %></span>
                <% if (!n.read) { %>
                    <form action="/notifications/<%= n.id %>/read" method="POST">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Marcar como lida</button>
                    </form>
                <% } %>
            </div>
        </div>
    <% }); %>

    <a href="/lobby" class="btn btn-link">Voltar</a>
</div>