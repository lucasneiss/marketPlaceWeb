<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Catálogo da loja</p><h1 class="h2 mb-0">Meus produtos</h1></div><div><a href="/seller" class="btn btn-outline-secondary">Painel</a> <a href="/seller/products/new" class="btn btn-brand">Cadastrar produto</a></div></div>
<% if (!products.length) { %><div class="alert alert-light border">Nenhum produto cadastrado.</div><% } %>
<div class="table-responsive"><table class="table align-middle bg-white"><thead><tr><th>Produto</th><th>Categoria</th><th>Preço</th><th>Estoque</th><th>Situação</th><th>Ações</th></tr></thead><tbody><% products.forEach(function(product){ %><tr data-seller-product="<%= product.id %>"><td><strong><%= product.name %></strong><div class="small text-muted"><%= product.slug %></div></td><td><%= product.category.name %></td><td><%= product.formattedPrice %></td><td><div class="input-group input-group-sm" style="max-width:130px"><input class="form-control" type="number" min="0" value="<%= product.quantity %>" data-stock-input><button class="btn btn-outline-primary" data-save-stock>Salvar</button></div><small class="text-danger <%= product.quantity <= 5 ? '' : 'd-none' %>" data-low-stock>Estoque baixo</small></td><td><span class="badge <%= product.status === 'ACTIVE' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= product.status %></span></td><td><div class="d-flex flex-wrap gap-1"><a href="/seller/products/<%= product.id %>/edit" class="btn btn-sm btn-outline-primary">Editar</a><form action="/seller/products/<%= product.id %>/toggle" method="POST"><button class="btn btn-sm btn-outline-secondary"><%= product.status === 'ACTIVE' ? 'Desativar' : 'Ativar' %></button></form>
<form
    action="/seller/products/<%= product.id %>/delete"
    method="POST"
    data-confirm
    data-confirm-title="Excluir produto"
    data-confirm-message="Deseja excluir ou desativar este produto? Ele poderá deixar de aparecer para os clientes."
    data-confirm-label="Sim, continuar"
    data-confirm-variant="btn-danger"
>
    <button
        type="submit"
        class="btn btn-sm btn-outline-danger"
    >
        Excluir
    </button>
</form>
</div>
</td></tr>
    <% }) %></tbody>
</table>
</div>
