<div class="d-flex justify-content-between align-items-end mb-4">
    <div><p class="text-muted mb-1">Organização do catálogo</p><h1 class="h2 mb-0">Categorias</h1></div>
    <a href="/admin" class="btn btn-outline-secondary">Painel</a>
</div>
<div class="row g-4">
    <div class="col-lg-4">
        <form action="/admin/categories" method="POST" class="card card-body shadow-sm">
            <h2 class="h5">Nova categoria</h2>
            <div class="mb-3"><label class="form-label">Nome</label><input class="form-control" name="name" required></div>
            <div class="mb-3"><label class="form-label">Descrição</label><textarea class="form-control" name="description"></textarea></div>
            <button class="btn btn-brand">Criar categoria</button>
        </form>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm"><div class="card-body">
            <% categories.forEach(function(category) { %>
                <form action="/admin/categories/<%= category.id %>" method="POST" class="row g-2 align-items-end border-top py-3">
                    <div class="col-md-3"><label class="form-label small">Nome</label><input class="form-control" name="name" value="<%= category.name %>" required></div>
                    <div class="col-md-5"><label class="form-label small">Descrição</label><input class="form-control" name="description" value="<%= category.description || '' %>"></div>
                    <div class="col-md-2"><small class="text-muted"><%= category.products.length %> produtos</small></div>
                    <div class="col-md-2 d-flex gap-1">
                    <button
                        type="submit"
                        class="btn btn-sm btn-outline-danger"
                        formaction="/admin/categories/<%= category.id %>/delete"
                        data-confirm
                        data-confirm-title="Excluir categoria"
                        data-confirm-message="Deseja excluir esta categoria?"
                        data-confirm-label="Sim, excluir categoria"
                        data-confirm-variant="btn-danger"          
                        <%= category.products.length ? 'disabled' : '' %>
                    >Excluir</button>
                    <button class="btn btn-sm btn-outline-danger" formaction="/admin/categories/<%= category.id %>/delete" <%= category.products.length ? 'disabled' : '' %>>Excluir</button>
                    </div>
                </form>
            <% }) %>
        </div></div>
    </div>
</div>
