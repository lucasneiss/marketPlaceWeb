<nav aria-label="Navegação estrutural"><ol class="breadcrumb product-breadcrumb mb-4"><li class="breadcrumb-item"><a href="/">Início</a></li><li class="breadcrumb-item"><a href="/catalog">Catálogo</a></li><li class="breadcrumb-item"><a href="/catalog?category=<%= product.category.slug %>"><%= product.category.name %></a></li><li class="breadcrumb-item active"><%= product.name %></li></ol></nav>
<article class="product-detail-card" data-product-detail data-product-id="<%= product.id %>" data-product-slug="<%= product.slug %>">
    <div class="row g-0">
        <div class="col-lg-6">
            <div class="product-detail-image <%= product.imageClass %> <%= product.positionClass %>">
                <% if (!product.isSprite) { %><img src="<%= product.imageUrl %>" alt="<%= product.name %>" class="w-100 h-100 object-fit-cover"><% } %>
                <% if (product.discountLabel) { %><span class="product-detail-discount"><%= product.discountLabel %></span><% } %>
            </div>
            <% if (product.images && product.images.length > 1) { %><div class="row g-2 p-3"><% product.images.slice(1).forEach(function(image) { %><div class="col-4"><img src="<%= image.url %>" alt="<%= image.altText || product.name %>" class="img-fluid rounded border"></div><% }) %></div><% } %>
        </div>
        <div class="col-lg-6"><div class="product-detail-content">
            <a class="product-detail-category" href="/catalog?category=<%= product.category.slug %>"><%= product.category.name %></a>
            <h1 class="product-detail-title"><%= product.name %></h1>
            <div class="product-detail-meta"><span class="catalog-rating"><i class="bi bi-star-fill"></i> <%= Number(product.rating).toFixed(1).replace('.', ',') %> <small>(<%= product.reviewCount %> avaliações)</small></span><span class="product-condition"><i class="bi bi-box-seam"></i> <%= product.conditionLabel %></span></div>
            <p class="product-detail-description"><%= product.description %></p>
            <div class="product-detail-pricing"><% if (product.formattedOldPrice) { %><span class="product-detail-old-price"><%= product.formattedOldPrice %></span><% } %><strong><%= product.formattedPrice %></strong><span>Pagamento simulado</span></div>
            <div class="product-stock <%= product.isAvailable ? 'is-available' : 'is-unavailable' %>" data-stock-label><i class="bi <%= product.isAvailable ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %>"></i> <%= product.availabilityLabel %></div>
            <div class="d-grid gap-2 mt-4">
                <% if (product.isAvailable && isClient) { %><div class="input-group"><input type="number" class="form-control" min="1" max="<%= product.quantity %>" value="1" data-product-quantity><button class="btn btn-brand btn-lg" data-add-cart data-product-id="<%= product.id %>"><i class="bi bi-cart3 me-2"></i>Adicionar ao carrinho</button></div><% } else if (product.isAvailable && !currentUser) { %><a class="btn btn-brand btn-lg" href="/login">Entrar para comprar</a><% } else if (!product.isAvailable) { %><button class="btn btn-secondary btn-lg" disabled>Produto indisponível</button><% } %>
                <a class="btn btn-outline-brand" href="/catalog">Continuar explorando</a>
            </div>
        </div></div>
    </div>
</article>
<section class="seller-public-card mt-4"><span class="seller-public-icon"><i class="bi bi-shop"></i></span><div><p class="section-eyebrow mb-1">Vendido por</p><h2><a href="/sellers/<%= product.seller.slug %>"><%= product.seller.storeName %></a></h2><p class="mb-0"><%= product.seller.description %></p></div></section>
<section class="mt-5"><div class="d-flex justify-content-between align-items-end"><div><p class="section-eyebrow mb-1">Opiniões verificadas</p><h2 class="section-title">Avaliações</h2></div></div>
    <% if (!product.reviews || product.reviews.length === 0) { %><p class="text-muted">Ainda não há avaliações aprovadas para este produto.</p><% } %>
    <div class="row g-3"><% (product.reviews || []).forEach(function(review) { %><div class="col-md-6"><article class="card h-100"><div class="card-body"><strong><%= review.client.name %></strong><div class="text-warning"><% for(let i=0;i<review.rating;i++){ %><i class="bi bi-star-fill"></i><% } %></div><p class="mb-0 mt-2"><%= review.comment %></p></div></article></div><% }) %></div>
</section>
<section class="related-products-section"><div class="d-flex align-items-end justify-content-between gap-3 mb-4"><div><p class="section-eyebrow mb-2">Continue explorando</p><h2 class="section-title mb-0">Produtos relacionados</h2></div></div><div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-4"><% relatedProducts.forEach(function(item) { %><%- include('../partials/catalog-product-card', { product: item }) %><% }) %></div></section>
