<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Moderação de lojas</p><h1 class="h2 mb-0">Vendedores</h1></div><a href="/admin" class="btn btn-outline-secondary">Painel</a></div><div class="table-responsive"><table class="table bg-white align-middle"><thead><tr><th>Loja</th><th>Responsável</th><th>Situação</th><th>Página pública</th><th>Alterar</th></tr></thead><tbody><% sellers.forEach(function(seller){ %><tr><td><strong><%= seller.storeName %></strong><div class="small text-muted"><%= seller.description %></div></td><td><%= seller.user.name %><br><small><%= seller.user.email %></small></td><td><span class="badge text-bg-light"><%= seller.status %></span></td><td><a href="/sellers/<%= seller.slug %>">Abrir</a></td><td><form action="/admin/sellers/<%= seller.id %>/status" method="POST" class="d-flex gap-2"><select name="status" class="form-select form-select-sm"><option value="PENDING" <%= seller.status==='PENDING'?'selected':'' %>>Pendente</option><option value="APPROVED" <%= seller.status==='APPROVED'?'selected':'' %>>Aprovado</option><option value="SUSPENDED" <%= seller.status==='SUSPENDED'?'selected':'' %>>Suspenso</option></select><button class="btn btn-sm btn-outline-primary">Salvar</button></form></td></tr><% }) %></tbody></table></div>
