<div class="col-lg-6 mx-auto"><h1 class="h2">Trocar senha</h1><% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %><form action="/change-password" method="POST" class="card card-body shadow-sm"><div class="mb-3"><label class="form-label">Senha atual</label><input type="password" name="currentPassword" class="form-control" required></div><div class="mb-3"><label class="form-label">Nova senha</label><input type="password" name="newPassword" minlength="6" class="form-control" required></div><div class="mb-3"><label class="form-label">Confirmar nova senha</label><input type="password" name="confirmPassword" minlength="6" class="form-control" required></div><div class="d-flex gap-2"><button class="btn btn-brand">Salvar</button><a href="/profile" class="btn btn-outline-secondary">Voltar</a></div></form></div>
