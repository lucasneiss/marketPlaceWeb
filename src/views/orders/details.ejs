<% const labels={PENDING:'Aguardando confirmação',CONFIRMED:'Confirmado',PREPARING:'Em preparação',SHIPPED:'Enviado',DELIVERED:'Entregue',CANCELED:'Cancelado'}; %>
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4"><div><p class="text-muted mb-1">Detalhes do pedido</p><h1 class="h2 mb-1"><%= order.number %></h1><span class="badge text-bg-primary" data-order-status data-order-id="<%= order.id %>"><%= order.statusLabel %></span></div><a href="/orders" class="btn btn-outline-secondary">Voltar</a></div>
<div class="row g-4"><div class="col-lg-8">
    <section class="card shadow-sm mb-4"><div class="card-body"><h2 class="h5">Produtos</h2><% order.items.forEach(function(item) { %><article class="border-top py-3"><div class="d-flex justify-content-between gap-3"><div><strong><%= item.quantity %>x <%= item.productName %></strong><div class="small text-muted">Vendido por <%= item.sellerName %> · <%= item.formattedUnitPrice %> cada</div></div><strong><%= item.formattedSubtotal %></strong></div><% if (order.status === 'DELIVERED' && !item.review && item.productId) { %><form action="/orders/<%= order.id %>/items/<%= item.id %>/review" method="POST" class="row g-2 mt-3"><div class="col-md-2"><select class="form-select" name="rating" required><option value="5">5 estrelas</option><option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1</option></select></div><div class="col-md-8"><input class="form-control" name="comment" minlength="3" maxlength="1000" placeholder="Conte como foi sua experiência" required></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Avaliar</button></div></form><% } else if (item.review) { %><div class="alert alert-light border mt-3 mb-0">Avaliação enviada: <strong><%= item.review.rating %>/5</strong> · situação: <%= item.review.status %></div><% } %></article><% }) %></div></section>
    <section class="card shadow-sm"><div class="card-body"><h2 class="h5">Histórico de estados</h2><ol class="list-group list-group-numbered"><% order.history.forEach(function(change) { %><li class="list-group-item"><strong><%= labels[change.newStatus] || change.newStatus %></strong><div class="small text-muted"><%= new Date(change.createdAt).toLocaleString('pt-BR') %> · <%= change.actor ? change.actor.name : 'Sistema' %></div><% if (change.observation) { %><div><%= change.observation %></div><% } %></li><% }) %></ol></div></section>
</div><aside class="col-lg-4"><div class="card shadow-sm mb-3"><div class="card-body"><h2 class="h5">Resumo</h2><dl><dt>Total</dt><dd><%= order.formattedTotal %></dd><dt>Pagamento</dt><dd><%= order.paymentLabel %></dd><dt>Entrega</dt><dd><%= order.deliveryLabel %> (<%= order.formattedShipping %>)</dd></dl></div></div><div class="card shadow-sm"><div class="card-body"><h2 class="h5">Endereço</h2><p class="mb-0"><%= order.recipientName %><br><%= order.street %>, <%= order.addressNumber %><br><%= order.neighborhood %> - <%= order.city %>/<%= order.state %><br>CEP <%= order.postalCode %></p></div></div><% if (canCancel) { %><form action="/orders/<%= order.id %>/cancel" method="POST" class="mt-3" onsubmit="return confirm('Cancelar este pedido e devolver os itens ao estoque?')"><button class="btn btn-outline-danger w-100">Cancelar pedido</button></form><% } %></aside></div>
