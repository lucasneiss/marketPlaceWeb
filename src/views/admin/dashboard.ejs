<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Visão geral da plataforma</p><h1 class="h2 mb-0">Painel administrativo</h1></div><a href="/lobby" class="btn btn-outline-secondary">Minha área</a></div>
<div class="row g-3 mb-4"><% [['Usuários',metrics.users,'bi-people'],['Clientes',metrics.clients,'bi-person'],['Vendedores',metrics.sellers,'bi-shop'],['Produtos',metrics.products,'bi-box'],['Pedidos',metrics.orders,'bi-receipt'],['Produtos inativos',metrics.inactiveProducts,'bi-eye-slash'],['Avaliações pendentes',metrics.pendingReviews,'bi-chat-square-text']].forEach(function(card){ %><div class="col-6 col-md-4 col-xl"><div class="card h-100 shadow-sm"><div class="card-body"><i class="bi <%= card[2] %> fs-3"></i><div class="fs-4 fw-bold mt-2"><%= card[1] %></div><small class="text-muted"><%= card[0] %></small></div></div></div><% }) %></div>
<div class="row g-4"><div class="col-lg-7"><div class="card shadow-sm"><div class="card-body"><h2 class="h5">Pedidos recentes</h2><div class="list-group list-group-flush"><% recentOrders.forEach(function(order){ %><div class="list-group-item d-flex justify-content-between"><span><%= order.number %><small class="d-block text-muted"><%= order.statusLabel %></small></span><strong><%= order.formattedTotal %></strong></div><% }) %></div></div></div></div><div class="col-lg-5"><div class="card shadow-sm"><div class="card-body"><h2 class="h5">Gerenciamento</h2><div class="d-grid gap-2"><a class="btn btn-outline-primary" href="/admin/users">Usuários</a><a class="btn btn-outline-primary" href="/admin/sellers">Vendedores</a><a class="btn btn-outline-primary" href="/admin/categories">Categorias</a><a class="btn btn-outline-primary" href="/admin/products">Produtos</a><a class="btn btn-outline-primary" href="/admin/orders">Pedidos</a><a class="btn btn-outline-primary" href="/admin/reviews">Avaliações</a></div></div></div></div></div>
