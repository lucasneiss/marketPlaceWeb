<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof titulo !== 'undefined' ? titulo : 'Marketplace' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex flex-column min-vh-100">
<nav class="navbar navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="#">Marketplace Web</a>
        <% if (typeof username !== 'undefined' && username) { %>
            <span class="navbar-text text-white">Jogador: <strong><%= username %></strong></span>
        <% } %>
    </div>
</nav>

<div class="container my-5 flex-grow-1">
    <%- body %>
</div>

<footer class="text-center py-3 bg-dark text-secondary mt-auto">
    <p class="mb-0">&copy; 2026 - Desenvolvido com Node.js/p>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>