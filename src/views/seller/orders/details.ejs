<% const labels={PENDING:'Aguardando confirmação',CONFIRMED:'Confirmado',PREPARING:'Em preparação',SHIPPED:'Enviado',DELIVERED:'Entregue',CANCELED:'Cancelado'}; %>
<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Pedido recebido</p><h1 class="h2 mb-1"><%= order.number %></h1><span class="badge text-bg-primary" data-seller-order-status><%= order.statusLabel %></span></div><a href="/seller/orders" class="btn btn-outline-secondary">Voltar</a></div>
<div class="row g-4"><div class="col-lg-8"><section class="card shadow-sm mb-4"><div class="card-body"><h2 class="h5">Produtos da sua loja</h2><% order.items.forEach(function(item){ %><div class="d-flex justify-content-between border-top py-3"><span><strong><%= item.quantity %>x <%= item.productName %></strong><small class="d-block text-muted"><%= item.formattedUnitPrice %> cada</small></span><strong><%= item.formattedSubtotal %></strong></div><% }) %></div></section><section class="card shadow-sm"><div class="card-body"><h2 class="h5">Histórico</h2><% order.history.forEach(function(change){ %><div class="border-top py-2"><strong><%= labels[change.newStatus]||change.newStatus %></strong><div class="small text-muted"><%= new Date(change.createdAt).toLocaleString('pt-BR') %> · <%= change.actor?change.actor.name:'Sistema' %></div><div><%= change.observation||'' %></div></div><% }) %></div></section></div>
<aside class="col-lg-4"><div class="card shadow-sm mb-3"><div class="card-body"><h2 class="h5">Cliente e entrega</h2><p><strong><%= order.client.name %></strong><br><%= order.client.email %></p><p class="mb-0"><%= order.recipientName %><br><%= order.street %>, <%= order.addressNumber %><br><%= order.city %>/<%= order.state %></p></div></div><% if (allowedTransitions.length) { %><form class="card card-body shadow-sm" data-order-status-form data-order-id="<%= order.id %>"><h2 class="h5">Atualizar estado</h2><select class="form-select mb-2" name="status" required><% allowedTransitions.forEach(function(status){ %><option value="<%= status %>"><%= labels[status]||status %></option><% }) %></select><textarea class="form-control mb-2" name="observation" maxlength="255" placeholder="Observação opcional"></textarea><button class="btn btn-brand">Salvar estado</button><div class="small mt-2" data-status-message></div></form><% } %></aside></div>
