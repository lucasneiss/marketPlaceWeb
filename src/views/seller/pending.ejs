<div class="col-lg-7 mx-auto"><div class="card shadow-sm"><div class="card-body p-5 text-center"><i class="bi bi-hourglass-split display-4"></i><h1 class="h3 mt-3"><%= seller.storeName %></h1><p>Situação da loja: <strong><%= seller.status %></strong></p><% if (seller.status === 'PENDING') { %><p class="text-muted">A administração precisa aprovar a loja antes do cadastro de produtos.</p><% } else { %><p class="text-danger">A loja está suspensa. Procure a administração.</p><% } %><a href="/seller/profile" class="btn btn-outline-primary">Editar perfil da loja</a></div></div></div>
