<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Moderação do catálogo</p><h1 class="h2 mb-0">Produtos</h1></div><a href="/admin" class="btn btn-outline-secondary">Painel</a></div><div class="table-responsive"><table class="table bg-white align-middle"><thead><tr><th>Produto</th><th>Vendedor</th><th>Categoria</th><th>Preço</th><th>Estoque</th><th>Situação</th><th></th></tr></thead><tbody><% products.forEach(function(product){ %><tr><td><a href="/products/<%= product.slug %>"><strong><%= product.name %></strong></a></td><td><%= product.seller.storeName %></td><td><%= product.category.name %></td><td><%= product.formattedPrice %></td><td><%= product.quantity %></td><td><span class="badge <%= product.status==='ACTIVE'?'text-bg-success':'text-bg-secondary' %>"><%= product.status %></span></td><td><form action="/admin/products/<%= product.id %>/toggle" method="POST"><button class="btn btn-sm <%= product.status==='ACTIVE'?'btn-outline-danger':'btn-outline-success' %>"><%= product.status==='ACTIVE'?'Ocultar':'Reativar' %></button></form></td></tr><% }) %></tbody></table></div>
