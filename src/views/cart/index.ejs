<div data-cart-page>
    <% if (query.invalid) { %><div class="alert alert-warning">Revise os itens: há produto indisponível, loja suspensa ou quantidade acima do estoque.</div><% } %>
    <div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Compra simulada</p><h1 class="h2 mb-0">Meu carrinho</h1></div><a href="/catalog" class="btn btn-outline-secondary">Continuar comprando</a></div>
    <% if (!cart.items.length) { %><div class="alert alert-light border text-center py-5" data-empty-cart><i class="bi bi-cart-x fs-1"></i><h2 class="h4 mt-3">Seu carrinho está vazio</h2><a href="/catalog" class="btn btn-brand mt-2">Explorar produtos</a></div><% } %>
    <% if (cart.items.length) { %><div class="row g-4"><div class="col-lg-8" data-cart-items>
        <% cart.items.forEach(function(item) { %><article class="card mb-3 shadow-sm" data-cart-item="<%= item.id %>"><div class="card-body"><div class="row align-items-center g-3"><div class="col-md-2"><div class="ratio ratio-1x1 rounded overflow-hidden bg-light <%= item.product.imageClass %> <%= item.product.positionClass %>"><% if (!item.product.isSprite) { %><img
            src="<%= item.product.imageUrl %>"
            alt="<%= item.product.imageAltText || item.product.name %>"
            class="object-fit-cover"
        ><% } %></div></div><div class="col-md-5"><h2 class="h5"><a href="/products/<%= item.product.slug %>" class="text-reset"><%= item.product.name %></a></h2><p class="text-muted mb-1"><%= item.product.seller.storeName %></p><strong><%= item.product.formattedPrice %></strong><% if (!item.valid) { %><div class="text-danger small">Quantidade indisponível ou produto desativado.</div><% } %></div><div class="col-md-3"><label class="form-label small">Quantidade</label><input type="number" min="1" max="<%= item.product.quantity %>" value="<%= item.quantity %>" class="form-control" data-cart-quantity></div><div class="col-md-2 text-md-end"><strong data-item-subtotal><%= item.formattedSubtotal %></strong><button class="btn btn-sm btn-link text-danger d-block ms-md-auto mt-2" data-remove-cart>Remover</button></div></div></div></article><% }) %>
    </div><aside class="col-lg-4"><div class="card shadow-sm position-sticky" style="top: 100px"><div class="card-body"><h2 class="h5">Resumo</h2><div class="d-flex justify-content-between py-3 border-bottom"><span>Produtos</span><strong data-cart-total><%= cart.formattedTotal %></strong></div><p class="small text-muted mt-3">Frete calculado no checkout. Todos os valores são validados novamente pelo servidor.</p><a href="/checkout" class="btn btn-brand btn-lg w-100 <%= cart.canCheckout ? '' : 'disabled' %>" data-checkout-button>Ir para checkout</a></div></div></aside></div><% } %>
</div>
