<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4"><div><p class="text-muted mb-1">Loja <%= seller.storeName %></p><h1 class="h2 mb-0">Painel do vendedor</h1></div><div class="d-flex gap-2"><a href="/seller/products/new" class="btn btn-brand">Novo produto</a><a href="/seller/profile" class="btn btn-outline-secondary">Perfil da loja</a></div></div>
<div class="row g-3 mb-4"><% [['Produtos',metrics.productCount,'bi-box'],['Ativos',metrics.activeCount,'bi-check-circle'],['Sem estoque',metrics.outOfStockCount,'bi-exclamation-triangle'],['A processar',metrics.pendingOrderCount,'bi-hourglass-split'],['Unidades vendidas',metrics.unitsSold,'bi-bag-check'],['Vendas simuladas',metrics.salesTotal,'bi-currency-dollar']].forEach(function(card){ %><div class="col-6 col-lg"><div class="card h-100 shadow-sm"><div class="card-body"><i class="bi <%= card[2] %> fs-3"></i><div class="fs-4 fw-bold mt-2"><%= card[1] %></div><div class="text-muted small"><%= card[0] %></div></div></div></div><% }) %></div>
<div class="row g-4"><div class="col-lg-7"><div class="card shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">Pedidos recentes</h2><a href="/seller/orders">Ver todos</a></div><% if (!recentOrders.length) { %><p class="text-muted">Nenhum pedido.</p><% } %><div class="list-group list-group-flush"><% recentOrders.forEach(function(order){ %><a class="list-group-item list-group-item-action d-flex justify-content-between" href="/seller/orders/<%= order.id %>"><span><%= order.number %><small class="d-block text-muted"><%= order.statusLabel %></small></span><strong><%= order.formattedTotal %></strong></a><% }) %></div></div></div></div><div class="col-lg-5"><div class="card shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">Avaliações recentes</h2><a href="/seller/reviews">Ver todas</a></div><% if (!recentReviews.length) { %><p class="text-muted">Nenhuma avaliação.</p><% } %><% recentReviews.forEach(function(review){ %><div class="border-top py-2"><strong><%= review.product.name %></strong><div class="text-warning"><%= review.rating %>/5</div><small><%= review.comment %></small></div><% }) %></div></div></div></div>
<div class="mt-4 d-flex flex-wrap gap-2"><a class="btn btn-outline-primary" href="/seller/products">Gerenciar produtos</a><a class="btn btn-outline-primary" href="/seller/orders">Pedidos recebidos</a><a class="btn btn-outline-primary" href="/seller/reviews">Avaliações</a></div>
