<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Vendas da loja</p><h1 class="h2 mb-0">Pedidos recebidos</h1></div><a href="/seller" class="btn btn-outline-secondary">Painel</a></div><% if (!orders.length) { %><div class="alert alert-light border">Nenhum pedido contém produtos da sua loja.</div><% } %><div class="table-responsive"><table class="table bg-white align-middle"><thead><tr><th>Pedido</th><th>Data</th><th>Itens da loja</th><th>Total geral</th><th>Estado</th><th></th></tr></thead><tbody><% orders.forEach(function(order){ %><tr><td><strong><%= order.number %></strong></td><td><%= new Date(order.createdAt).toLocaleString('pt-BR') %></td><td><%= order.items.reduce((s,i)=>s+i.quantity,0) %></td><td><%= order.formattedTotal %></td><td><span class="badge text-bg-light"><%= order.statusLabel %></span></td><td><a href="/seller/orders/<%= order.id %>" class="btn btn-sm btn-outline-primary">Abrir</a></td></tr><% }) %></tbody></table></div>
