<div class="col" data-product-card data-search="<%= product.name %> <%= product.category.name %> <%= product.seller.storeName %>" data-category="<%= product.category.name %>">
    <article class="product-card h-100">
        <a class="product-image <%= product.imageClass %> <%= product.positionClass %>" href="/products/<%= product.slug %>">
            <% if (!product.isSprite) { %><img src="<%= product.imageUrl %>" alt="<%= product.name %>" class="w-100 h-100 object-fit-cover"><% } %>
            <% if (product.discountLabel) { %><span class="discount-badge"><%= product.discountLabel %></span><% } %>
        </a>
        <div class="product-card-body">
            <p class="product-category mb-1"><%= product.category.name %></p>
            <h3 class="product-name"><a class="text-decoration-none text-reset" href="/products/<%= product.slug %>"><%= product.name %></a></h3>
            <p class="small text-muted mb-2">por <a href="/sellers/<%= product.seller.slug %>"><%= product.seller.storeName %></a></p>
            <div class="d-flex align-items-center gap-2 mb-3"><span class="star-rating"><i class="bi bi-star-fill"></i> <%= Number(product.rating).toFixed(1) %></span><span class="review-count">(<%= product.reviewCount %>)</span></div>
            <div class="d-flex flex-wrap align-items-baseline gap-2"><strong class="product-price"><%= product.formattedPrice %></strong><% if (product.formattedOldPrice) { %><span class="old-price"><%= product.formattedOldPrice %></span><% } %></div>
            <div class="mt-3 d-grid gap-2">
                <a class="btn btn-outline-brand btn-sm" href="/products/<%= product.slug %>">Ver detalhes</a>
                <% if (isClient && product.isAvailable) { %><button class="btn btn-brand btn-sm" data-add-cart data-product-id="<%= product.id %>"><i class="bi bi-cart-plus"></i> Adicionar</button><% } %>
            </div>
        </div>
    </article>
</div>
