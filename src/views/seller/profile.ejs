<div class="col-lg-7 mx-auto"><div class="d-flex justify-content-between mb-3"><div><p class="text-muted mb-1">Área do vendedor</p><h1 class="h2">Perfil da loja</h1></div><a href="/seller" class="btn btn-outline-secondary align-self-start">Voltar</a></div><form action="/seller/profile" method="POST" class="card card-body shadow-sm"><div class="mb-3"><label class="form-label">Nome da loja</label><input class="form-control" name="storeName" value="<%= seller.storeName %>" required></div><div class="mb-3"><label class="form-label">Descrição pública</label><textarea class="form-control" name="description" rows="4"><%= seller.description || '' %></textarea></div><div class="mb-3"><label class="form-label">URL do logotipo (opcional)</label><input class="form-control" type="url" name="logoUrl" value="<%= seller.logoUrl || '' %>"></div><p class="small text-muted">Situação: <strong><%= seller.status %></strong> · Página pública: <a href="/sellers/<%= seller.slug %>">/sellers/<%= seller.slug %></a></p><button class="btn btn-brand">Salvar</button></form></div>
