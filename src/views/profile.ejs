<div class="col-lg-7 mx-auto"><h1 class="h2">Meu perfil</h1><p class="text-muted">Edite os dados da sua conta.</p><% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %><form action="/profile" method="POST" class="card card-body shadow-sm"><div class="mb-3"><label class="form-label">Nome</label><input type="text" name="name" class="form-control" value="<%= user.name %>" required></div><div class="mb-3"><label class="form-label">E-mail</label><input type="email" name="email" class="form-control" value="<%= user.email %>" required></div><div class="d-flex gap-2 flex-wrap"><button class="btn btn-brand">Salvar alterações</button><a href="/change-password" class="btn btn-outline-primary">Trocar senha</a><a href="/lobby" class="btn btn-outline-secondary">Voltar</a></div></form></div>
