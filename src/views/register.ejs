<div class="row justify-content-center"><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-lg-5">
    <h1 class="h2">Criar uma conta</h1><p class="text-muted">Escolha se deseja comprar ou abrir uma loja.</p>
    <% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
    <form action="/register" method="POST" id="registerForm">
        <div class="mb-3"><label class="form-label" for="name">Nome completo</label><input class="form-control" id="name" name="name" value="<%= values.name || '' %>" required minlength="2"></div>
        <div class="mb-3"><label class="form-label" for="email">E-mail</label><input class="form-control" type="email" id="email" name="email" value="<%= values.email || '' %>" required></div>
        <div class="mb-3"><label class="form-label" for="password">Senha</label><input class="form-control" type="password" id="password" name="password" minlength="6" required><div class="form-text">Mínimo de 6 caracteres.</div></div>
        <div class="mb-3"><label class="form-label" for="role">Tipo de conta</label><select class="form-select" id="role" name="role" required><option value="CLIENT" <%= values.role !== 'SELLER' ? 'selected' : '' %>>Cliente</option><option value="SELLER" <%= values.role === 'SELLER' ? 'selected' : '' %>>Vendedor</option></select></div>
        <div id="sellerFields" class="border rounded p-3 mb-3 <%= values.role === 'SELLER' ? '' : 'd-none' %>">
            <div class="mb-3"><label class="form-label" for="storeName">Nome da loja</label><input class="form-control" id="storeName" name="storeName" value="<%= values.storeName || '' %>"></div>
            <div><label class="form-label" for="description">Descrição pública</label><textarea class="form-control" id="description" name="description" rows="3"><%= values.description || '' %></textarea></div>
            <div class="form-text">Novas lojas ficam pendentes até a aprovação do administrador.</div>
        </div>
        <button class="btn btn-brand btn-lg w-100">Criar conta</button>
    </form>
    <p class="text-center mt-4 mb-0">Já tem uma conta? <a href="/login">Entrar</a></p>
</div></div></div></div>
<script>
(function(){const role=document.getElementById('role');const fields=document.getElementById('sellerFields');const store=document.getElementById('storeName');function update(){const seller=role.value==='SELLER';fields.classList.toggle('d-none',!seller);store.required=seller;}role.addEventListener('change',update);update();})();
</script>
