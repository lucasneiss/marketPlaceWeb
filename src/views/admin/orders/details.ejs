<% const labels={PENDING:'Aguardando confirmação',CONFIRMED:'Confirmado',PREPARING:'Em preparação',SHIPPED:'Enviado',DELIVERED:'Entregue',CANCELED:'Cancelado'}; %>
<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Acompanhamento administrativo</p><h1 class="h2 mb-1"><%= order.number %></h1><span class="badge text-bg-primary"><%= order.statusLabel %></span></div><a href="/admin/orders" class="btn btn-outline-secondary">Voltar</a></div>
<div class="row g-4"><div class="col-lg-8"><section class="card shadow-sm mb-4"><div class="card-body"><h2 class="h5">Itens</h2><% order.items.forEach(function(item){ %><div class="d-flex justify-content-between border-top py-3"><span><strong><%= item.quantity %>x <%= item.productName %></strong><small class="d-block text-muted"><%= item.sellerName %> · <%= item.formattedUnitPrice %> cada</small></span><strong><%= item.formattedSubtotal %></strong></div><% }) %></div></section><section class="card shadow-sm"><div class="card-body"><h2 class="h5">Histórico</h2><% order.history.forEach(function(change){ %><div class="border-top py-2"><strong><%= labels[change.newStatus]||change.newStatus %></strong><div class="small text-muted"><%= new Date(change.createdAt).toLocaleString('pt-BR') %> · <%= change.actor?change.actor.name:'Sistema' %></div><div><%= change.observation||'' %></div></div><% }) %></div></section></div><aside class="col-lg-4"><div class="card shadow-sm"><div class="card-body"><h2 class="h5">Cliente</h2><p><strong><%= order.client.name %></strong><br><%= order.client.email %></p><h2 class="h5">Entrega</h2><p><%= order.recipientName %><br><%= order.street %>, <%= order.addressNumber %><br><%= order.city %>/<%= order.state %></p><h2 class="h5">Total</h2><p class="fs-4 fw-bold"><%= order.formattedTotal %></p></div></div></aside></div>
