<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Feedback dos clientes</p><h1 class="h2 mb-0">Avaliações recebidas</h1></div><a href="/seller" class="btn btn-outline-secondary">Painel</a></div><div class="row g-3"><% reviews.forEach(function(review){ %><div class="col-md-6"><article class="card h-100 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><strong><%= review.product.name %></strong><span class="badge text-bg-light"><%= review.status %></span></div><div class="text-warning my-2"><%= review.rating %>/5</div><p><%= review.comment %></p><small class="text-muted">Por <%= review.client.name %> em <%= new Date(review.createdAt).toLocaleDateString('pt-BR') %></small></div></article></div><% }) %></div><% if(!reviews.length){ %><div class="alert alert-light border">Nenhuma avaliação recebida.</div><% } %>
