<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-muted mb-1">Acompanhamento geral</p><h1 class="h2 mb-0">Pedidos da plataforma</h1></div><a href="/admin" class="btn btn-outline-secondary">Painel</a></div>
<div class="table-responsive"><table class="table bg-white align-middle"><thead><tr><th>Pedido</th><th>Cliente</th><th>Data</th><th>Itens</th><th>Total</th><th>Estado</th><th></th></tr></thead><tbody><% orders.forEach(function(order){ %><tr><td><strong><%= order.number %></strong></td><td><%= order.client.name %><br><small><%= order.client.email %></small></td><td><%= new Date(order.createdAt).toLocaleString('pt-BR') %></td><td><%= order.items.reduce((sum,item)=>sum+item.quantity,0) %></td><td><%= order.formattedTotal %></td><td><span class="badge text-bg-light"><%= order.statusLabel %></span></td><td><a class="btn btn-sm btn-outline-primary" href="/admin/orders/<%= order.id %>">Abrir</a></td></tr><% }) %></tbody></table></div>
